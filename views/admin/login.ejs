<!doctype html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body>
    <div class="login-layout blank-login">
      <aside class="login-aside">
        <a href="/" aria-label="Pirento Blank home" class="focus-ring login-brand inline-flex min-h-6 items-center"><%- include('../partials/brand') %></a>
        <div>
          <span class="section-index">ADMIN PANEL</span>
          <h1>Run the <br />platform.</h1>
          <p>Members, plans, payments<br />and integrations.</p>
        </div>
        <span class="fineprint">PIRENTO BLANK / ADMINISTRATORS ONLY</span>
      </aside>
      <main class="login" data-admin-login>
        <span class="eyebrow">ADMIN SIGN-IN</span>
        <h2>Administrator sign-in</h2>
        <p class="muted">Members sign in at <a class="text-accent underline" href="/login">the member login</a>.</p>
        <p data-admin-login-error role="alert" class="mt-6 border border-negative bg-negative-soft px-3 py-2 text-sm text-negative" <%= initialError ? '' : 'hidden' %>><%= initialError || '' %></p>
        <% if (googleEnabled) { %>
        <div class="mt-8">
          <%- include('../partials/google-button', { href: '/auth/google?for=admin', label: 'Sign in with Google' }) %>
        </div>
        <% } else { %>
        <p role="note" class="mt-8 border border-caution bg-caution-soft px-3 py-2 text-sm">
          Google sign-in is not set up yet. On the server, add GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GOOGLE_AUTH_ENABLED="true" to .env, then restart (see START-HERE.md).
        </p>
        <% } %>
        <small class="mt-6 block">Administrators sign in only with their Google account and then a code from their authenticator app. There is no admin password.</small>
      </main>
    </div>
  </body>
</html>
