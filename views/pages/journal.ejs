<div class="space-y-6 py-6">
  <div class="workspace-pagehead">
    <div>
      <h1><%= t('Journal') %></h1>
      <p><%= t('Log a trade as you take it, and write down what you were thinking while you still remember.') %></p>
    </div>
  </div>
  <% if (!workspace) { %>
    <p role="alert" class="text-sm text-muted">Journal data could not be loaded.</p>
  <% } %>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
    <div class="space-y-6">
      <div class="rounded-card border border-line bg-surface">
        <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
          <h3 class="text-base font-normal text-fg">Log a trade</h3>
        </div>
        <div class="p-4 sm:p-5" data-trade-form></div>
      </div>
      <div class="rounded-card border border-line bg-surface">
        <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
          <h3 class="text-base font-normal text-fg">Recent trades</h3>
        </div>
        <div class="p-4 sm:p-5" data-recent-trades></div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="rounded-card border border-line bg-surface">
        <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
          <h3 class="text-base font-normal text-fg">Record a strategy</h3>
        </div>
        <div class="p-4 sm:p-5">
          <form class="space-y-4" data-strategy-form novalidate>
            <fieldset class="min-w-0 space-y-4" <%= workspace ? '' : 'disabled' %>>
              <p role="alert" class="mt-1 text-xs text-negative" data-strategy-error hidden></p>
              <div class="space-y-2">
                <label for="strategy-date" class="<%= LABEL_CLASS %>">Date</label>
                <input id="strategy-date" name="date" type="date" required class="<%= FIELD_CLASS %> border-line-strong" value="<%= today %>">
              </div>
              <div class="space-y-2">
                <label for="strategy-name" class="<%= LABEL_CLASS %>">Strategy name</label>
                <input id="strategy-name" name="name" maxlength="120" placeholder="e.g. Morning Breakout" class="<%= FIELD_CLASS %> border-line-strong">
              </div>
              <div class="space-y-2">
                <label for="strategy-rules" class="<%= LABEL_CLASS %>">Rules</label>
                <textarea id="strategy-rules" name="rules" class="<%= TEXTAREA_CLASS %> border-line-strong min-h-[100px]" placeholder="1. Wait for the first 15m close… 2. Volume above average…"></textarea>
              </div>
              <div class="space-y-2">
                <label for="strategy-improvements" class="<%= LABEL_CLASS %>">Daily improvements / fixes</label>
                <textarea id="strategy-improvements" name="improvements" class="<%= TEXTAREA_CLASS %> border-line-strong min-h-[80px]" placeholder="Stop entering early. Wait for the confirmation candle to close."></textarea>
              </div>
              <div class="space-y-2">
                <label for="strategy-notes" class="<%= LABEL_CLASS %>">Notes</label>
                <textarea id="strategy-notes" name="notes" class="<%= TEXTAREA_CLASS %> border-line-strong min-h-[80px]" placeholder="Observations or temporary adjustments."></textarea>
              </div>
              <button type="submit" class="<%= buttonClass('outline', 'default', 'w-full') %>">Save strategy</button>
            </fieldset>
          </form>
        </div>
      </div>
      <div class="rounded-card border border-line bg-surface">
        <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
          <h3 class="text-base font-normal text-fg">Strategy Logs</h3>
        </div>
        <div class="p-4 sm:p-5" data-strategy-logs></div>
      </div>
    </div>
  </div>
</div>
