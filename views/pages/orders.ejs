<div class="space-y-6 py-6">
  <div class="workspace-pagehead">
    <div>
      <h1><%= t('Order review') %></h1>
      <p><%= t('Review saved plans before connecting to execution.') %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/calculator" class="<%= buttonClass('outline') %>">Open calculator <%- icon('arrow-right', { size: 14, className: 'ml-2' }) %></a>
    </div>
  </div>
  <div data-sync-status></div>
  <p class="text-sm text-muted">Saved plans are not broker orders, executions or journal profits.</p>
  <p role="alert" class="mt-1 text-xs text-negative" data-plan-error hidden></p>
  <section aria-label="Prepared plans" class="space-y-4" data-plans></section>
  <div data-broker-portfolio></div>
</div>
