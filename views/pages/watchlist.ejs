<div class="reference-page reference-watchlist">
  <div class="workspace-pagehead">
    <div>
      <h1><%= t('Watchlist') %></h1>
      <p><%= t('Your selected instruments / Provider quote snapshots.') %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/today" class="<%= buttonClass('primary', 'sm') %>">Find candidates <%- icon('arrow-right', { size: 14, className: 'ml-2' }) %></a>
    </div>
  </div>

  <div class="reference-watch-sections">
    <div class="rounded-card border border-line bg-surface reference-watch-saved">
      <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
        <h3 class="text-base font-normal text-fg">
          Saved instruments <span class="ml-2 tnum text-sm text-muted"><%= String(workspace.watchlist.length).padStart(2, '0') %></span>
        </h3>
      </div>
      <div class="p-4 sm:p-5">
        <% if (!workspace.watchlist.length) { %>
        <div class="flex flex-col items-center justify-center rounded-card border border-dashed border-line px-6 py-12 text-center">
          <div class="mb-3 text-subtle"><%- icon('search', { size: 32 }) %></div>
          <h3 class="text-sm font-medium text-fg">No items in watchlist</h3>
          <p class="mt-1 max-w-xs text-xs text-muted">Add an NSE symbol to start your research. Saved instruments remain until you remove them.</p>
          <div class="mt-4"><a href="/today" class="<%= buttonClass('outline') %>">Open Today</a></div>
        </div>
        <% } else { %>
        <div class="reference-table-scroll" tabindex="0" role="region" aria-label="Saved instruments table, scroll for all columns">
          <table class="reference-stock-table" aria-label="Saved instruments">
            <thead>
              <tr>
                <th scope="col">Instrument</th>
                <th scope="col">Quote snapshot</th>
                <th scope="col">Change</th>
                <th scope="col">Planning</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% workspace.watchlist.forEach((item, index) => { %>
              <tr data-watch-row data-id="<%= item.id %>" data-symbol="<%= item.symbol %>">
                <th scope="row">
                  <div class="reference-symbol-cell">
                    <span class="reference-row-number"><%= String(index + 1).padStart(2, '0') %></span>
                    <div>
                      <span class="reference-symbol"><%= item.symbol %></span>
                      <small>NSE · Saved instrument</small>
                      <small class="tnum">Added <%= new Date(item.addedAt).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }) %></small>
                    </div>
                  </div>
                </th>
                <td class="reference-quote-cell"><div aria-live="polite" aria-atomic="true" data-quote></div></td>
                <td class="font-mono tnum" data-change><span class="text-muted">—<span class="sr-only">Change unavailable</span></span></td>
                <td>
                  <a href="/calculator?symbol=<%= encodeURIComponent(item.symbol) %>" class="focus-ring reference-text-link" aria-label="Calculate <%= item.symbol %> position">
                    Calculate <%- icon('arrow-right', { size: 15 }) %>
                  </a>
                </td>
                <td>
                  <div class="reference-watch-actions">
                    <button type="button" data-refresh class="<%= buttonClass('outline', 'sm') %>" aria-label="Refresh <%= item.symbol %> quote"><%- icon('refresh-cw', { size: 14 }) %></button>
                    <button type="button" data-alert class="<%= buttonClass('outline', 'sm') %>" aria-label="Set a price alert for <%= item.symbol %>"><%- icon('bell', { size: 14 }) %></button>
                    <a class="<%= buttonClass('outline', 'sm') %>" href="/chart?symbol=<%= encodeURIComponent(item.symbol) %>" aria-label="Open the live <%= item.symbol %> chart">
                      Chart <%- icon('chart-candlestick', { size: 14, className: 'ml-2' }) %>
                    </a>
                    <button type="button" data-remove class="<%= buttonClass('ghost', 'sm', 'text-negative hover:bg-negative-soft') %>" aria-label="Remove <%= item.symbol %> from watchlist">
                      <%- icon('trash-2', { size: 16 }) %><span>Remove</span>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>

    <div class="rounded-card border border-line bg-surface reference-watch-add">
      <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
        <h3 class="text-base font-normal text-fg">Add an instrument</h3>
      </div>
      <div class="p-4 sm:p-5">
        <form data-add-form class="flex flex-col gap-4">
          <input
            data-symbol-input
            aria-label="Symbol or company name"
            aria-describedby="watchlist-symbol-help"
            placeholder="NSE symbol, e.g. RELIANCE"
            maxlength="200"
            class="<%= FIELD_CLASS %>"
          />
          <p id="watchlist-symbol-help" class="text-xs leading-5 text-muted">
            Enter an NSE trading symbol directly, or find one by company name with AI.
          </p>
          <button type="submit" data-add-manual class="<%= buttonClass('default', 'default', 'w-full') %>" disabled>Add symbol</button>
          <div data-ai-search></div>
        </form>
      </div>
    </div>
  </div>
  <div class="mt-6" data-alerts></div>
</div>
