<section class="my-6 rounded-card border border-line bg-surface p-6">
  <h1 class="text-lg font-semibold">Page not found</h1>
  <p class="mt-2 text-sm text-muted">This page does not exist. Choose a page from the navigation, or search with ⌘K / Ctrl K.</p>
  <div class="mt-4 flex flex-wrap gap-3">
    <a href="/dashboard" class="<%= buttonClass() %>">Go to dashboard</a>
    <button type="button" data-open-palette class="<%= buttonClass('outline') %>">Search pages</button>
  </div>
</section>
