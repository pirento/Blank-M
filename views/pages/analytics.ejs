<%
  const aiAvailable = Boolean(health?.openai);
  const aiNotice = (feature) => `
    <div class="rounded-card border border-caution/40 bg-caution-soft p-4">
      <div class="flex items-start gap-3">
        ${icon('sparkles', { size: 18, className: 'mt-0.5 shrink-0 text-caution' })}
        <div>
          <p class="text-sm font-medium text-fg">${feature} is temporarily unavailable</p>
          <p class="mt-1 text-sm text-muted">The secure OpenAI service is not configured on this deployment. Contact your workspace administrator; personal API keys are never stored in the browser.</p>
        </div>
      </div>
    </div>`;
  const capabilities = [
    ['P&L analysis', 'Upload PDF statements for insights on win rate, drawdown and risk metrics.'],
    ['Strategy refinement', 'Describe your rules and the AI will look for logical gaps and edge cases.'],
    ['Rule enforcement', 'Your trading constitution is sent with every message, so critique is measured against your own rules.'],
    ['Voice capture', 'Transcribe a short voice note, edit the text, then send or save it. Audio is uploaded temporarily for transcription. Cleanup may be delayed if the connection fails.'],
    ['Private journal search', 'Find evidence across your trades, strategies, rules and prior reviews with owner-scoped semantic search.'],
  ];
  const field = `${FIELD_CLASS} border-line-strong`;
  const area = `${TEXTAREA_CLASS} border-line-strong`;
%>
<div class="chat-reference">
  <div class="workspace-pagehead">
    <div>
      <h1><%= t('Chat with AI') %></h1>
      <p><%= t('A conversation grounded in your trading record.') %></p>
    </div>
  </div>
  <div class="chat-reference-layout">
    <div class="chat-reference-panel flex flex-col rounded-card border border-line bg-surface">
      <div class="flex flex-row items-center justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
        <h3 class="flex items-center gap-2 text-base font-normal text-fg"><%- icon('bot', { className: 'text-accent' }) %> OpenAI Analyst</h3>
        <div class="flex items-center gap-1" data-chat-actions></div>
      </div>
      <div class="flex flex-1 flex-col p-0">
        <div class="flex-1 space-y-6 overflow-y-auto p-4 md:p-6" data-messages>
          <div class="chat-reference-intro">
            <span class="font-mono text-xs tracking-widest text-accent">PIRENTO / RESEARCH ASSISTANT</span>
            <h2>What would you like<br>to understand?</h2>
            <p>Review a trade, question a setup or develop a strategy.</p>
            <div class="chat-prompts">
              <button type="button" class="<%= buttonClass('outline') %>" data-prompt="Review my trading rules">Review my trading rules →</button>
              <button type="button" class="<%= buttonClass('outline') %>" data-prompt="Help me define testable entry conditions">Define entry conditions →</button>
            </div>
          </div>
          <div class="space-y-6" data-message-list></div>
          <div data-stream></div>
          <div data-chat-notice></div>
          <div data-messages-end></div>
        </div>
        <div class="border-t border-line bg-surface p-4">
          <% if (aiAvailable) { %>
            <form class="flex items-end gap-2" data-chat-form>
              <div class="flex flex-1 items-end gap-2 rounded-card border border-line bg-elevated p-2 transition-colors focus-within:border-accent">
                <label class="cursor-pointer rounded-control p-2 text-muted transition-colors hover:bg-surface hover:text-fg">
                  <input type="file" accept=".pdf,image/*" class="sr-only" data-attachment>
                  <%- icon('upload-cloud', { size: 20 }) %>
                  <span class="sr-only">Attach a document</span>
                </label>
                <label class="cursor-pointer rounded-control p-2 text-muted transition-colors hover:bg-surface hover:text-fg">
                  <input type="file" accept="audio/*,.m4a" class="sr-only" data-voice>
                  <%- icon('mic', { size: 20 }) %>
                  <span class="sr-only">Transcribe a voice note</span>
                </label>
                <div class="relative flex flex-1 flex-col justify-end">
                  <div data-attached></div>
                  <ul id="chat-suggestions" role="listbox" aria-label="Trading term suggestions" class="absolute bottom-full mb-2 w-64 max-w-full overflow-hidden rounded-card border border-line bg-surface shadow-xl" data-suggestions hidden></ul>
                  <textarea rows="2" aria-label="Message" aria-autocomplete="list" class="w-full resize-none border-0 bg-transparent p-2 tnum text-sm text-fg outline-none placeholder:text-subtle" placeholder="Ask about your trades, market conditions, or strategies…" data-question></textarea>
                </div>
              </div>
              <div data-send-slot></div>
            </form>
            <div data-preparation></div>
            <div data-material></div>
          <% } else { %>
            <%- aiNotice('The AI Analyst') %>
          <% } %>
        </div>
      </div>
    </div>

    <div class="chat-reference-tools">
      <div class="rounded-card border border-line bg-surface">
        <div class="border-b border-line px-4 py-4 sm:px-5">
          <h3 class="flex items-center gap-2 text-base font-normal text-fg"><%- icon('search', { size: 16, className: 'text-accent' }) %> Search your journal</h3>
        </div>
        <div class="p-4 sm:p-5">
          <% if (aiAvailable) { %>
            <form class="space-y-3" data-search-form>
              <input class="<%= field %>" placeholder="What patterns follow my largest losses?" aria-label="Search your private journal" data-search-query>
              <button type="submit" class="<%= buttonClass('default', 'default', 'w-full') %>" data-search-submit><%- icon('sparkles', { size: 14, className: 'mr-2' }) %> Search privately</button>
            </form>
            <div data-search-result></div>
          <% } else { %>
            <%- aiNotice('Private journal search') %>
          <% } %>
        </div>
      </div>

      <div class="rounded-card border border-line bg-surface">
        <div class="border-b border-line px-4 py-4 sm:px-5"><h3 class="text-base font-normal text-fg">Strategy generator</h3></div>
        <div class="p-4 sm:p-5">
          <% if (aiAvailable) { %>
            <form class="space-y-4" data-generator-form>
              <div class="space-y-2">
                <label for="sg-name" class="<%= LABEL_CLASS %>">Strategy name</label>
                <input id="sg-name" name="name" class="<%= field %>" placeholder="e.g. Iron Condor Grid">
              </div>
              <div class="space-y-2">
                <label for="sg-concept" class="<%= LABEL_CLASS %>">Core concept / rules</label>
                <textarea id="sg-concept" name="concept" class="<%= area %> min-h-[100px]" placeholder="RSI crossover on the 15m timeframe with…"></textarea>
              </div>
              <div class="space-y-2">
                <label for="sg-constraints" class="<%= LABEL_CLASS %>">Constraints / improvements</label>
                <textarea id="sg-constraints" name="constraints" class="<%= area %>" placeholder="Limit max drawdown to 5%…"></textarea>
              </div>
              <button type="submit" class="<%= buttonClass('default', 'default', 'w-full') %>" data-generate disabled>Generate strategy</button>
            </form>
          <% } else { %>
            <%- aiNotice('The strategy generator') %>
          <% } %>
        </div>
      </div>

      <div class="rounded-card border border-line bg-surface">
        <div class="border-b border-line px-4 py-4 sm:px-5"><h3 class="text-base font-normal text-fg">Capabilities</h3></div>
        <div class="space-y-4 p-4 text-xs text-muted sm:p-5">
          <% for (const [title, body] of capabilities) { %>
            <div class="border-l border-line-strong pl-3">
              <h4 class="mb-1 text-xs tracking-wide text-fg uppercase"><%= title %></h4>
              <p class="leading-relaxed opacity-70"><%= body %></p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
