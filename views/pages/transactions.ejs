<div class="space-y-6 py-6">
  <div class="workspace-pagehead">
    <div>
      <h1><%= t('Trade book') %></h1>
      <p><%= t('Verified executions and imported history, kept separate.') %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="<%= buttonClass('outline') %>" data-export disabled>
        <%- icon('download', { size: 14, className: 'mr-2' }) %> Export CSV
      </button>
    </div>
  </div>

  <div data-broker-portfolio></div>
  <section class="rr-panel">
    <h2>Import history</h2>
    <p class="rr-muted">
      Preview Excel or CSV columns, validate dates and quantities, and review duplicates before
      saving to your journal. Imported records remain separate from broker-confirmed executions.
    </p>
    <a href="/import" class="<%= buttonClass('outline') %>">Import Excel / CSV</a>
  </section>
  <div>
    <h2 class="text-xl font-normal">Journal records</h2>
    <p class="mt-1 text-sm text-muted" data-summary></p>
    <p class="mt-1 text-sm text-muted">Manual and imported journal entries are not verified broker executions.</p>
  </div>

  <div class="rounded-card border border-line bg-surface">
    <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-4 sm:px-5">
      <h3 class="text-base font-normal text-fg">Filters</h3>
      <div class="flex items-center gap-2" data-filter-actions></div>
    </div>
    <div class="flex flex-wrap gap-2 border-b border-line px-5 py-3" data-views hidden></div>
    <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2 sm:p-5 md:grid-cols-4 xl:grid-cols-7">
      <div class="space-y-2">
        <label for="tx-search" class="<%= LABEL_CLASS %>">Search</label>
        <input id="tx-search" class="<%= FIELD_CLASS %> border-line-strong" placeholder="Symbol or note" data-filter="search">
      </div>
      <div class="space-y-2">
        <label for="tx-direction" class="<%= LABEL_CLASS %>">Direction</label>
        <select id="tx-direction" class="<%= FIELD_CLASS %> border-line-strong" data-filter="direction">
          <option value="all">All</option>
          <option value="Long">Long</option>
          <option value="Short">Short</option>
        </select>
      </div>
      <div class="space-y-2">
        <label for="tx-outcome" class="<%= LABEL_CLASS %>">Outcome</label>
        <select id="tx-outcome" class="<%= FIELD_CLASS %> border-line-strong" data-filter="outcome">
          <option value="all">All</option>
          <option value="wins">Wins</option>
          <option value="losses">Losses</option>
        </select>
      </div>
      <div class="space-y-2">
        <label for="tx-segment" class="<%= LABEL_CLASS %>">Segment</label>
        <select id="tx-segment" class="<%= FIELD_CLASS %> border-line-strong" data-filter="segment">
          <option value="all">All</option>
          <option value="EQ">Equity</option>
          <option value="FUT">Futures</option>
          <option value="OPT">Options</option>
        </select>
      </div>
      <div class="space-y-2">
        <label for="tx-strategy" class="<%= LABEL_CLASS %>">Strategy</label>
        <select id="tx-strategy" class="<%= FIELD_CLASS %> border-line-strong" data-filter="strategy">
          <option value="all">All</option>
          <option value="none">No strategy</option>
          <% for (const strategy of (workspace?.strategies ?? [])) { %>
          <option value="<%= strategy.id %>"><%= strategy.name %></option>
          <% } %>
        </select>
      </div>
      <div class="space-y-2">
        <label for="tx-from" class="<%= LABEL_CLASS %>">From</label>
        <input id="tx-from" type="date" class="<%= FIELD_CLASS %> border-line-strong" data-filter="from">
      </div>
      <div class="space-y-2">
        <label for="tx-to" class="<%= LABEL_CLASS %>">To</label>
        <input id="tx-to" type="date" class="<%= FIELD_CLASS %> border-line-strong" data-filter="to">
      </div>
    </div>
  </div>

  <p class="text-sm text-muted" data-range-error hidden></p>
  <div data-selection></div>
  <div class="rounded-card border border-line bg-surface" data-ledger></div>
</div>
