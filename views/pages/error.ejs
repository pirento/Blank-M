<!doctype html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body>
    <main class="flex min-h-dvh flex-col items-center justify-center gap-4 bg-canvas px-6 text-center text-fg">
      <%- include('../partials/brand') %>
      <h1 class="mt-4 text-xl font-semibold"><%= status === 404 ? 'Page not found' : 'Something went wrong' %></h1>
      <p role="alert" class="max-w-md text-sm text-muted"><%= message %></p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="<%= buttonClass('outline') %>">Go home</a>
        <a href="/login" class="<%= buttonClass() %>">Sign in</a>
      </div>
    </main>
  </body>
</html>
