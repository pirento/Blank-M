<template id="workspace-menu-template">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="mb-1 font-mono text-[10px] tracking-[0.16em] text-subtle uppercase"><%= t('Blank workspace') %></p>
      <h2 class="text-lg font-semibold"><%= t('Menu') %></h2>
    </div>
    <button
      type="button"
      data-menu-close
      aria-label="<%= t('Close menu') %>"
      class="focus-ring workspace-topbar-control text-muted hover:bg-elevated"
    >
      <%- icon('x', { size: 18 }) %>
    </button>
  </div>
  <div class="mb-5 flex flex-wrap items-center gap-2">
    <button type="button" data-menu-search class="focus-ring workspace-topbar-control">
      <%- icon('search', { size: 15 }) %> <%= t('Search and commands') %>
    </button>
    <a href="/journal" aria-label="<%= t('Log a new trade') %>" class="focus-ring workspace-topbar-control">
      <%- icon('plus', { size: 15 }) %> <%= t('Log trade') %>
    </a>
    <button
      type="button"
      data-theme-toggle
      class="focus-ring workspace-topbar-control text-muted transition-colors hover:bg-elevated hover:text-fg"
    ></button>
  </div>
  <p class="mb-5 text-xs text-muted"><%= locals.health && health.openai ? t('AI ready') : t('AI unavailable') %></p>
  <nav aria-label="<%= t('More workspace pages') %>">
    <% for (const group of secondaryGroups) { %>
    <div class="mb-4">
      <p class="px-3 pb-2 text-[11px] font-medium tracking-wide text-subtle uppercase"><%= group.group %></p>
      <div class="space-y-1">
        <% for (const link of group.items) { const active = currentPath === link.path; %>
        <a
          href="<%= link.path %>"
          <% if (active) { %>aria-current="page"<% } %>
          class="focus-ring flex min-h-11 items-center gap-3 rounded-control px-3 py-2 text-sm font-medium transition-colors <%= active ? 'bg-accent-soft text-accent' : 'text-muted hover:bg-elevated hover:text-fg' %>"
        >
          <%- icon(link.icon, { size: 17 }) %> <%= link.name %>
        </a>
        <% } %>
      </div>
    </div>
    <% } %>
  </nav>
  <p class="px-3 text-xs leading-relaxed text-muted">
    <%= t('Your main sections are in the bottom navigation. Search finds workspace pages, too.') %>
  </p>
  <div class="mt-6 border-t border-line pt-4">
    <% if (currentUser) { %>
    <p class="break-all px-3 pb-2 text-xs text-subtle"><%= currentUser.email %></p>
    <% } %>
    <a
      href="/settings#report-problem"
      class="focus-ring flex min-h-11 items-center gap-3 rounded-control px-3 py-2 text-sm font-medium text-muted hover:bg-elevated hover:text-fg"
    >
      <%- icon('life-buoy', { size: 16 }) %> <%= t('Report a problem') %>
    </a>
    <button
      type="button"
      data-sign-out
      class="focus-ring flex min-h-11 w-full items-center gap-3 rounded-control px-3 py-2 text-sm font-medium text-muted hover:bg-elevated hover:text-negative"
    >
      <%- icon('log-out', { size: 16 }) %> <%= t('Sign out') %>
    </button>
  </div>
</template>
