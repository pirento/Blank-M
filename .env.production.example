# ---------------------------------------------------------------------------
# Pirento Blank — production settings for a VPS behind Nginx (HTTPS).
# Copy to /srv/blank/.env, fill in every "CHANGE ME" and keep the file private
# (chmod 600 .env). Secrets: run `node scripts/generate-secrets.js`.
# ---------------------------------------------------------------------------

NODE_ENV="production"
PORT="3000"
# Listen on loopback only; Nginx is the single way in.
HOST="127.0.0.1"
TRUST_PROXY="true"
# Your HTTPS address, no trailing slash. CHANGE ME
APP_URL="https://blank.example.com"

# Local MongoDB (deploy/setup-vps.sh installs it) or a MongoDB Atlas URI. CHANGE ME if Atlas
MONGODB_URI="mongodb://127.0.0.1:27017/blank"

# From scripts/generate-secrets.js. CHANGE ME
SESSION_SECRET=""
MFA_ENCRYPTION_KEY=""
CRON_SECRET=""
BROKER_TOKEN_ENCRYPTION_KEY=""

# Zerodha Kite Connect (developers.kite.trade → My apps). CHANGE ME
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_REDIRECT_URI="https://blank.example.com/api/kite/callback"
BROKER_FRESH_AUTH_SECONDS="300"

# Optional read-only fills → journal. Leave empty to hide the connect button.
# Upstox app (account.upstox.com/developer/apps); redirect URI: <APP_URL>/api/upstox/callback
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
# Fyers app (myapi.fyers.in), app ID like XXXX-100; redirect URI: <APP_URL>/api/fyers/callback
FYERS_APP_ID=""
FYERS_SECRET_ID=""

# Real-money orders: keep "false" until the first manual test is done.
LIVE_TRADING_ENABLED="false"
LIVE_ORDER_MAX_VALUE="20000"
LIVE_ORDER_MAX_QUANTITY="500"
LIVE_ORDER_DAILY_LIMIT="5"
LIVE_ORDER_MAX_PRICE_DEVIATION_PERCENT="3"

# Optional: OpenAI for AI chat, coach and research.
OPENAI_API_KEY=""
OPENAI_ANALYSIS_MODEL="gpt-5.6-terra"
OPENAI_FAST_MODEL="gpt-5.6-luna"
AI_REQUESTS_PER_HOUR="30"

# Optional: email (invitations, password reset, weekly reports, alert emails).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional: push notifications. `node scripts/generate-vapid-keys.js`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional: Telegram bot (@BotFather), then `node scripts/telegram-set-webhook.js`.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Server alerts (app down, disk full, backup failed) go to this chat. Send /chatid to the bot to get it.
ALERT_TELEGRAM_CHAT_ID=""

# Optional: Google sign-in for invited addresses.
GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: copy the daily database backup off this server (Google Drive, S3...).
# Set up an rclone remote first (START-HERE.md → "Backup dusri jagah"), e.g. "gdrive-secret:".
BACKUP_REMOTE=""

LOG_LEVEL="info"
LOG_FORMAT=""
