{
  "name": "blank-trading-journal",
  "private": true,
  "version": "0.3.0",
  "description": "Pirento Blank — invite-only planning and trading journal (Express MVC, MongoDB, EJS).",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./public/css/app.css --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "seed:admin": "node scripts/create-admin.js",
    "maintenance:voice-notes": "node scripts/maintenance-voice-notes.js",
    "check": "npm run lint && npm run format:check && npm test",
    "test:watch": "vitest",
    "dev:memory": "node scripts/dev-memory.js",
    "maintenance:weekly-reports": "node scripts/send-weekly-reports.js",
    "test:e2e": "playwright test",
    "maintenance:price-checks": "node scripts/price-checks.js",
    "maintenance:daily-import": "node scripts/daily-import.js"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "connect-mongo": "^5.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-static": "^0.546.0",
    "marked": "^15.0.12",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "openai": "^7.5.0",
    "qrcode": "^1.5.4",
    "read-excel-file": "9.3.10",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.2.5",
    "web-push": "3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.56.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.4.2",
    "supertest": "^7.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.19.0"
}
