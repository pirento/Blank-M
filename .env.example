# ---------------------------------------------------------------------------
# Pirento Blank — Express + MongoDB + EJS
# Copy to .env (or .env.local) and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Core runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
MONGODB_URI="mongodb://127.0.0.1:27017/blank"
# At least 32 random characters in production. Signs session cookies and
# derives the key that encrypts authenticator (TOTP) secrets.
SESSION_SECRET=""
# Set to true only behind a trusted reverse proxy that terminates HTTPS. Behind more than one
# proxy, set how many, e.g. "2" for a load balancer in front of Nginx.
TRUST_PROXY="false"

# OpenAI (server-only)
OPENAI_API_KEY=""
# Alternative binding for environments reserving OPENAI_* names.
BLANK_OPENAI_API_KEY=""
OPENAI_ANALYSIS_MODEL="gpt-5.6-terra"
OPENAI_FAST_MODEL="gpt-5.6-luna"
AI_REQUESTS_PER_HOUR="30"

# Email (invitations and password recovery). Manual invitation links work without it.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional Google sign-in for already-invited addresses.
GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Zerodha Kite Connect (read-only market data and account snapshots).
KITE_API_KEY=""
KITE_API_SECRET=""
# Broker linking requires HTTPS. Match the exact registered callback and APP_URL origin.
KITE_REDIRECT_URI="https://your-blank-host.example/api/kite/callback"
BROKER_TOKEN_ENCRYPTION_KEY=""
# Recent app-sign-in window, integer seconds from 60 through 600.
BROKER_FRESH_AUTH_SECONDS="300"

# Scheduled maintenance (temporary voice-note cleanup). At least 32 characters.
CRON_SECRET=""

# Live orders through Zerodha (real money). Off unless set to "true".
# Members must also enable live orders in Settings and verify an authenticator.
LIVE_TRADING_ENABLED="false"
LIVE_ORDER_MAX_VALUE="50000"
LIVE_ORDER_MAX_QUANTITY="1000"
LIVE_ORDER_DAILY_LIMIT="5"
LIVE_ORDER_MAX_PRICE_DEVIATION_PERCENT="3"

# Logging: debug | info | warn | error (default info), and json | text
# (default json in production). Each request is logged with an X-Request-Id.
LOG_LEVEL="info"
LOG_FORMAT=""

# Push notifications (price alerts, installed app). Generate once with
# `node scripts/generate-vapid-keys.js`; VAPID_SUBJECT is a mailto: or https: contact.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Trade screenshots in an S3-compatible bucket (optional; also in the admin panel → Integrations).
# Used only when the bucket and both keys are set; otherwise screenshots stay in MongoDB GridFS.
# S3_ENDPOINT only for Cloudflare R2, DigitalOcean Spaces, Wasabi or MinIO; S3_REGION defaults to
# "auto" with an endpoint, otherwise "ap-south-1". Then: pnpm run maintenance:screenshots-to-s3
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Telegram bot (optional): create a bot with @BotFather, then run
# `node scripts/telegram-set-webhook.js` once. The secret is 32+ random characters.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
