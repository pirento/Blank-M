# crontab -e  (server clock in UTC; adjust if your server uses another timezone)
# Load the same APP_URL and CRON_SECRET the server uses, e.g. from /srv/blank/.env.

# Daily 02:00 UTC (07:30 IST): remove voice notes older than a day and AI statement uploads
# older than 7 days.
0 2 * * * cd /srv/blank && set -a && . ./.env && set +a && node scripts/maintenance-voice-notes.js >> /var/log/blank-cron.log 2>&1

# Daily 02:10 UTC (07:40 IST): delete public sign-ups never confirmed within 7 days.
10 2 * * * cd /srv/blank && set -a && . ./.env && set +a && node scripts/maintenance-signups.js >> /var/log/blank-cron.log 2>&1

# Daily 03:00 UTC (08:30 IST): "your free trial ends soon" emails.
0 3 * * * cd /srv/blank && set -a && . ./.env && set +a && node scripts/billing-reminders.js >> /var/log/blank-cron.log 2>&1

# Monday 02:30 UTC (08:00 IST): weekly report emails for members who opted in.
30 2 * * 1 cd /srv/blank && set -a && . ./.env && set +a && node scripts/send-weekly-reports.js >> /var/log/blank-cron.log 2>&1

# Monday–Friday 02:30 UTC (08:00 IST): pre-market plan on Telegram for members who turned on
# "Pre-market plan on Telegram" (skips NSE holidays and does nothing after 09:15 IST).
30 2 * * 1-5 cd /srv/blank && set -a && . ./.env && set +a && node scripts/premarket-plan.js >> /var/log/blank-cron.log 2>&1

# Every 5 minutes, Monday–Friday 03:45–10:00 UTC (09:15–15:30 IST): paper trade stops/targets,
# price alerts and automatic stop/target GTTs for filled live orders.
*/5 3-10 * * 1-5 cd /srv/blank && set -a && . ./.env && set +a && node scripts/price-checks.js >> /var/log/blank-cron.log 2>&1

# Monday–Friday 10:45 UTC (16:15 IST): today's Zerodha, Dhan, Upstox, Fyers and Angel One fills into
# the journal for members who turned on "Daily automatic journal", with the day's summary on Telegram.
45 10 * * 1-5 cd /srv/blank && set -a && . ./.env && set +a && node scripts/daily-import.js >> /var/log/blank-cron.log 2>&1
